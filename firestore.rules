rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isMember() { return signedIn() && role() in ['admin', 'team']; }
    function isAdmin() { return isMember() && role() == 'admin'; }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Create/edit user roles only in Firebase Console or trusted Admin SDK.
      allow write: if false;
    }
    match /companies/propnet/{collectionName}/{documentId} {
      allow read: if isMember();
      allow create, update: if isMember();
      allow delete: if isAdmin();
    }
  }
}
